<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No App Sandbox: the event tap, Accessibility reads and the system-audio tap need it off. -->
	<key>com.apple.security.device.audio-input</key><true/>
	<key>com.apple.security.automation.apple-events</key><true/>
	<!-- whisper and llama ship as dynamic frameworks re-signed with the local identity; the hardened runtime's
	     library validation needs this to load them under a self-signed certificate (no Team ID). -->
	<key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
